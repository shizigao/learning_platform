# Production backend environment template.
# Copy to /etc/learning-platform/backend.env, replace every placeholder,
# set owner root:learning-platform and mode 0640. Never commit the real file.

SERVER_PORT=8080
APP_ENV=prod
APP_CORS_ALLOWED_ORIGINS=https://learn.example.com
EXAM_RUNTIME_CACHE_ENABLED=true
EXAM_TIMEOUT_SCAN_MS=5000
EXAM_TIMEOUT_SCAN_INITIAL_DELAY_MS=5000

DB_URL=jdbc:mysql://127.0.0.1:3306/learning_platform?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=false&useSSL=false
DB_USERNAME=learning_platform
DB_PASSWORD=replace_with_production_database_password

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=replace_with_production_redis_password
REDIS_DATABASE=0
REDIS_CONNECT_TIMEOUT=2s
REDIS_COMMAND_TIMEOUT=1s
REDIS_DISTRIBUTED_GUARDS_ENABLED=true
REDIS_AUTH_SNAPSHOT_ENABLED=true
REDIS_AUTH_SNAPSHOT_TTL_SECONDS=60
REDIS_READ_CACHE_ENABLED=true
REDIS_AUTHORIZATION_CACHE_ENABLED=true
REDIS_AUTHORIZATION_CACHE_TTL_SECONDS=30
REDIS_CONTENT_VIEW_BUFFER_ENABLED=true
REDIS_CONTENT_VIEW_FLUSH_MILLIS=30000
REDIS_CONTENT_VIEW_FLUSH_INITIAL_DELAY_MILLIS=30000

# Must be reachable by end-user browsers because signed URLs use this origin.
MINIO_ENDPOINT=https://files.example.com
MINIO_ACCESS_KEY=replace_with_minio_application_access_key
MINIO_SECRET_KEY=replace_with_minio_application_secret_key
MINIO_BUCKET=learning-platform
UPLOAD_MAX_FILE_SIZE=200MB
UPLOAD_MAX_FILES_PER_CONTENT=20
UPLOAD_SIGNED_URL_TTL_MINUTES=10

JWT_SECRET=replace_with_an_independent_random_secret_of_at_least_32_bytes
JWT_ACCESS_TOKEN_TTL_MINUTES=120

LOGIN_PROTECTION_ENABLED=true
LOGIN_MAX_ACCOUNT_FAILURES=5
LOGIN_MAX_IP_FAILURES=20
LOGIN_PROTECTION_WINDOW_MINUTES=15
API_RATE_LIMIT_ENABLED=true
API_GENERAL_REQUESTS_PER_MINUTE=600
API_AUTH_REQUESTS_PER_MINUTE=30
API_UPLOAD_REQUESTS_PER_MINUTE=30

# Keep mock until real AI use is intentionally enabled and verified.
AI_PROVIDER=mock
AI_MOCK_MODEL=mock-learning-assistant-v1
AI_MOCK_SCENARIO=success
AI_MOCK_DELAY_MILLIS=0
AI_MAX_INPUT_CHARS=100000
AI_MAX_CONTEXT_MESSAGES=10
AI_MAX_CONTEXT_CHARS=20000
AI_REQUESTS_PER_WINDOW=10
AI_RATE_WINDOW_SECONDS=60
AI_MAX_CONCURRENT_PER_USER=1
AI_REQUEST_TIMEOUT_SECONDS=630

DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=replace_only_when_ai_provider_is_deepseek
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_CONNECT_TIMEOUT_SECONDS=10
DEEPSEEK_TIMEOUT_SECONDS=620
DEEPSEEK_THINKING_ENABLED=false
