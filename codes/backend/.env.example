# This file is only a variable-name template.
# Do not place real credentials in a tracked file.

# Application
SERVER_PORT=8080
APP_ENV=local
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173
EXAM_RUNTIME_CACHE_ENABLED=true
EXAM_TIMEOUT_SCAN_MS=5000
EXAM_TIMEOUT_SCAN_INITIAL_DELAY_MS=5000

# MySQL
DB_URL=jdbc:mysql://localhost:3306/learning_platform?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&useSSL=false
DB_USERNAME=learning_platform
DB_PASSWORD=replace_with_local_database_password

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=replace_with_local_redis_password
REDIS_DATABASE=0

# MinIO
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=replace_with_local_minio_access_key
MINIO_SECRET_KEY=replace_with_local_minio_secret_key
MINIO_BUCKET=learning-platform
UPLOAD_MAX_FILE_SIZE=200MB
UPLOAD_MAX_FILES_PER_CONTENT=20
UPLOAD_SIGNED_URL_TTL_MINUTES=10

# JWT: use a randomly generated value of at least 32 bytes locally and a
# separately generated stronger secret in production.
JWT_SECRET=replace_with_a_random_secret_of_at_least_32_bytes
JWT_ACCESS_TOKEN_TTL_MINUTES=120

# Redis-backed login protection. Set false only for controlled local debugging.
LOGIN_PROTECTION_ENABLED=true
LOGIN_MAX_ACCOUNT_FAILURES=5
LOGIN_MAX_IP_FAILURES=20
LOGIN_PROTECTION_WINDOW_MINUTES=15
API_RATE_LIMIT_ENABLED=true
API_GENERAL_REQUESTS_PER_MINUTE=600
API_AUTH_REQUESTS_PER_MINUTE=30
API_UPLOAD_REQUESTS_PER_MINUTE=30

# AI provider: use mock until the real DeepSeek API is intentionally enabled.
AI_PROVIDER=mock
AI_MOCK_MODEL=mock-learning-assistant-v1
AI_MOCK_SCENARIO=success
AI_MOCK_DELAY_MILLIS=0
AI_MAX_INPUT_CHARS=100000
AI_MAX_CONTEXT_MESSAGES=10
AI_MAX_CONTEXT_CHARS=20000
AI_REQUESTS_PER_WINDOW=10
AI_RATE_WINDOW_SECONDS=60
AI_MAX_CONCURRENT_PER_USER=1
AI_REQUEST_TIMEOUT_SECONDS=630
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=replace_with_your_deepseek_api_key
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_CONNECT_TIMEOUT_SECONDS=10
DEEPSEEK_TIMEOUT_SECONDS=620
DEEPSEEK_THINKING_ENABLED=false
